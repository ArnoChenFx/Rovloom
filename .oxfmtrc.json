{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "tabWidth": 2,
  "printWidth": 100,
  "semi": true,
  "sortImports": false,
  "sortPackageJson": false,
  "embeddedLanguageFormatting": "off",
  "ignorePatterns": [
    "node_modules/**",
    "dist/**",
    ".state/**",
    "coverage/**",
    "docs/**",
    "fixtures/**",
    "**/fixtures/**",
    "**/__fixtures__/**",
    "**/__snapshots__/**",
    "**/golden/**",
    "**/schema/**",
    "**/schemas/**",
    "**/evidence/**",
    "**/archive/**",
    "**/archives/**",
    "**/goldens/**",
    "**/third-party/**",
    "**/vendor/**",
    "**/third_party/**",
    "**/*.snap",
    "**/*.schema.*",
    "**/LICENSE*",
    "**/COPYING*",
    "test/**/*.json",
    "scripts/**/*.json",
    "bun.lock",
    "**/*.tar.gz",
    "**/*.zip",
    "**/*.log"
  ]
}
