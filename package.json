{
  "name": "luvus-mcp",
  "version": "0.1.0-dev",
  "private": true,
  "license": "MIT",
  "description": "Rovloom: planned multi-machine MCP gateway and connector for Luvus/Herdr (foundation only)",
  "type": "module",
  "packageManager": "bun@1.4.3",
  "engines": {
    "bun": "1.4.3"
  },
  "scripts": {
    "toolchain": "bun --no-env-file scripts/bun/toolchain.mjs",
    "build": "bun --no-env-file scripts/bun/build.mjs",
    "release:build": "bun --no-env-file scripts/release/build.mjs",
    "release:smoke": "bun --no-env-file scripts/release/smoke.mjs",
    "typecheck": "bun --no-env-file node_modules/typescript/bin/tsc --noEmit",
    "test": "bun --no-env-file test ./test",
    "smoke": "bun --no-env-file scripts/bun/smoke.mjs",
    "verify": "python3 scripts/bun/verify.py",
    "lint": "bun --no-env-file node_modules/oxlint/bin/oxlint --config .oxlintrc.json --deny-warnings --report-unused-disable-directives-severity error src test scripts",
    "lint:fix": "bun --no-env-file run lint --fix",
    "format": "bun --no-env-file node_modules/oxfmt/bin/oxfmt --config .oxfmtrc.json --write \"{src,test,scripts}/**/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}\" package.json tsconfig.json .oxlintrc.json .oxfmtrc.json",
    "format:check": "bun --no-env-file node_modules/oxfmt/bin/oxfmt --config .oxfmtrc.json --check \"{src,test,scripts}/**/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}\" package.json tsconfig.json .oxlintrc.json .oxfmtrc.json",
    "test:quality": "bun --no-env-file test ./test/quality",
    "comments:check": "bun --no-env-file scripts/maintenance/comments.mjs",
    "comments:equivalence": "bun --no-env-file scripts/maintenance/comment_equivalence.mjs",
    "audit:luvus": "bun --no-env-file scripts/luvus/audit-fixtures.mjs",
    "native:check": "bun --no-env-file scripts/native-contract/precompile-herdr.mjs",
    "native:generate": "bun --no-env-file scripts/native-contract/precompile-herdr.mjs --write",
    "test:protocol": "bun --no-env-file test ./test/luvus ./test/mcp/sdk-compatibility.test.mjs",
    "test:toolchain": "bun --no-env-file test ./test/toolchain/compatibility.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "ajv": "8.20.0"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "typescript": "7.0.2",
    "ws": "8.22.0"
  }
}
