{
  "name": "luvus-mcp",
  "version": "0.1.0-dev",
  "private": true,
  "description": "Rovloom: planned multi-machine MCP gateway and connector for Luvus/Herdr (foundation only)",
  "type": "module",
  "packageManager": "bun@1.4.3",
  "engines": { "bun": "1.4.3" },
  "scripts": {
    "toolchain": "bun --no-env-file scripts/bun/toolchain.mjs",
    "build": "bun --no-env-file scripts/bun/build.mjs",
    "typecheck": "bun --no-env-file node_modules/typescript/bin/tsc --noEmit",
    "test": "bun --no-env-file test ./test",
    "test:p0": "bun --no-env-file test ./scripts/p0/fixtures.test.mjs && python3 scripts/p0/test_endpoint.py",
    "p0:audit": "bun --no-env-file scripts/p0/audit-fixtures.mjs",
    "p0:bun-native": "python3 scripts/bun/audit_native.py",
    "test:bun": "bun --no-env-file test ./scripts/bun/compatibility.test.mjs",
    "smoke": "bun --no-env-file scripts/bun/smoke.mjs",
    "verify": "python3 scripts/bun/verify.py"
  },
  "dependencies": {
    "ajv": "8.20.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@types/node": "26.6.5",
    "typescript": "7.0.2",
    "ws": "8.22.0"
  }
}
