{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "eqeqeq": "error",
    "no-debugger": "error",
    "no-var": "error",
    "prefer-const": "error"
  },
  "ignorePatterns": [
    "node_modules/**",
    "dist/**",
    ".state/**",
    "coverage/**",
    "docs/**",
    "fixtures/**",
    "**/fixtures/**",
    "**/__fixtures__/**",
    "**/__snapshots__/**",
    "**/golden/**",
    "**/schema/**",
    "**/schemas/**",
    "**/evidence/**",
    "**/archive/**",
    "**/archives/**",
    "**/goldens/**",
    "**/third-party/**",
    "**/vendor/**",
    "**/third_party/**",
    "**/*.snap",
    "**/*.schema.*",
    "**/LICENSE*",
    "**/COPYING*"
  ]
}
