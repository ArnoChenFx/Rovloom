{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "eqeqeq": "error",
    "no-debugger": "error",
    "no-var": "error",
    "prefer-const": "error",
    "curly": ["error", "all"],
    "one-var": ["error", "never"]
  },
  "ignorePatterns": ["node_modules/**", "dist/**", ".state/**", "coverage/**", "docs/**"]
}
